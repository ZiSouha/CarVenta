# ==============================================
# CarVenta Frontend Environment Configuration
# ==============================================
# Copy this file to .env and configure for your environment.

# Currency symbol displayed across the application
VITE_CURRENCY=$

# Backend API Base URL
VITE_BASE_URL=http://localhost:3000

# WebSocket / Socket.IO Server URL (falls back to VITE_BASE_URL if unset)
VITE_SERVER_URL=http://localhost:3000

# Stripe Publishable Key (Test mode key starting with pk_test_)
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
