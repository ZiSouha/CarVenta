# ==============================================
# CarVenta Backend Environment Configuration
# ==============================================
# Copy this file to .env and provide your credentials.
# NEVER commit your real .env file to version control.

# Server Port
PORT=3000

# MongoDB Connection String (MongoDB Atlas or Local Instance)
# Example: mongodb+srv://<username>:<password>@cluster0.mongodb.net/car-rental?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/car-rental

# JSON Web Token Secret for Authentication
JWT_SECRET=your_super_secret_jwt_key_min_32_chars

# Frontend Application URL (Used for CORS, Email links, and Stripe redirects)
CLIENT_URL=http://localhost:5173

# ImageKit Configuration (For vehicle photo storage & uploads)
IMAGEKIT_PUBLIC_KEY=your_imagekit_public_key
IMAGEKIT_PRIVATE_KEY=your_imagekit_private_key
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_endpoint_id

# Stripe Payment Processing (Test mode keys starting with sk_test_ / whsec_)
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret

# Email Service (Nodemailer - for verification & password reset)
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_gmail_app_password

# Optional: Default Super Admin Credentials (used by createSuperAdmin.js)
ADMIN_EMAIL=admin@carventa.com
ADMIN_PASSWORD=Admin@CarVenta2026!
